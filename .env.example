# Clave secreta para firmar URLs con HMAC-SHA256
# IMPORTANTE: En producción, usa una clave larga y aleatoria (mínimo 32 caracteres)
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=tu-clave-secreta-debe-ser-muy-larga-y-aleatoria-cambiala-en-produccion

# Puerto donde se ejecutará el servidor
PORT=3000

# Entorno de ejecución: development, production, test
NODE_ENV=development
